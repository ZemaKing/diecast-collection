{
  "name": "diecast-collection",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "vite --open",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/check-bundle-secrets.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "supabase:check": "node --env-file-if-exists=.env.local scripts/check-supabase.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:push": "supabase db push",
    "import:cars": "tsx --env-file-if-exists=.env.local scripts/import/run.ts",
    "import:dates": "node scripts/import/build-added-dates.mjs",
    "verify:types": "node --env-file-if-exists=.env.local scripts/verify-types.mjs",
    "verify:rls": "node --env-file-if-exists=.env.local scripts/verify-rls.mjs",
    "verify:migration": "tsx --env-file-if-exists=.env.local scripts/verify-migration.ts",
    "verify:stats": "tsx --env-file-if-exists=.env.local scripts/verify-stats.ts",
    "verify:model-form": "tsx --env-file-if-exists=.env.local scripts/verify-model-form.ts",
    "images:migrate": "tsx --env-file-if-exists=.env.local scripts/images/cli.ts scripts/migrate-images/job.ts upload",
    "images:check": "tsx --env-file-if-exists=.env.local scripts/images/cli.ts scripts/migrate-images/job.ts verify",
    "images:flip": "tsx --env-file-if-exists=.env.local scripts/migrate-images/flip.ts",
    "icons": "node scripts/generate-icons.mjs",
    "images:verify": "tsx --env-file-if-exists=.env.local scripts/migrate-images/verify.ts",
    "db:types":"supabase gen types typescript --linked --schema diecast > src/lib/database.types.ts",
    "db:types:local": "supabase gen types typescript --local --schema diecast > src/lib/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.1.1",
    "sharp": "^0.35.5",
    "supabase": "^2.118.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^5.0.2"
  }
}
