# Copy to `.env.local` (git-ignored) and fill in. Types live in src/vite-env.d.ts.
# Only VITE_* variables are exposed to the browser bundle.

# Supabase → Project Settings → API (or "Connect" button).
# URL: https://<project-ref>.supabase.co   (local stack: http://127.0.0.1:54321)
VITE_SUPABASE_URL=
# The PUBLIC key: "anon" (legacy JWT, starts with eyJ…) or "publishable" (sb_publishable_…).
# The app refuses to start with a secret/service_role key here.
VITE_SUPABASE_ANON_KEY=

# Server/script-only secrets (Phase 7+) belong in `.env.local` or your shell, NEVER with a VITE_ prefix.
# The build fails (postbuild secret scan) if one ever ends up in dist/.
# SUPABASE_SERVICE_ROLE_KEY=
